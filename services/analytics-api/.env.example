# ── analytics-api (copiar a .env y completar) ──
# El servicio nunca imprime valores de variables; los errores indican el NOMBRE que falta.
# Mantén cualquier Secret Key solo en este .env local; no la compartas ni la pongas en Electron.

APP_ENV=development

# demo | connected
APP_MODE=connected

# Ruta del fixture demo (se resuelve desde services/analytics-api, no desde el cwd)
DEMO_DATASET_PATH=../../fixtures/demo-v1.json

# Requeridas cuando APP_MODE=connected (placeholders — complétalas localmente)
SUPABASE_URL=https://<project-ref>.supabase.co
# Elige una clave. La Secret Key tiene prioridad y omite RLS.
SUPABASE_PUBLISHABLE_KEY=<clave-publica-anon>
# SUPABASE_SECRET_KEY=<secret-key>

# Opcional: plazo promedio real del proveedor para evaluar riesgo de faltante.
# SUPPLIER_LEAD_TIME_WEEKS=2
